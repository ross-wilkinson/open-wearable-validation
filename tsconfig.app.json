{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "esnext",
    // "node" is here for the handful of tests that touch the filesystem
    // (src/styles/theme.test.ts reads index.css to assert a build invariant).
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* Linting.
       `strict` is not in Vite's current react-ts template output — it has to be
       added deliberately. `noUncheckedIndexedAccess` earns its keep in this
       project specifically: the stats core and the fixture-driven tests index
       into arrays constantly (`curve[i]`, `fixture.ppf[j]`), and without it
       TypeScript hands back a non-optional type for an access that can very
       much be out of bounds. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
